# nokia-voice-openclaw-gateway — environment template
# Copy to a private location OUTSIDE the repository and fill in real values.
# Never commit credentials, key paths, or real hostnames to the repository.

# ── Required ───────────────────────────────────────────────────────────────────

# Unique service principal for the bridge's OpenClaw identity.
# Format: identifier@domain.invalid   (must contain @; must not collide with any user principal)
NOKIA_GATEWAY_PRINCIPAL=nokia-bridge@example.invalid

# Verified non-loopback bridge-host address for trusted-proxy attribution.
# Documentation-only address: REPLACE it with your verified host address.
# Loopback 127.0.0.1 is skipped by the gateway proxy-chain resolver.
NOKIA_GATEWAY_CLIENT_IP=192.0.2.10

# Absolute path to the deployed ws module directory (npm installs it locally).
# Keep the runtime readable by the dedicated service user.
GATEWAY_RUNTIME=/path/to/nokia-voice-openclaw-gateway/node_modules/ws

# Public proxy hostname forwarded to the gateway (X-Forwarded-Host).
# Example: gateway.example.invalid   (use your actual Funnel/proxy hostname)
NOKIA_GATEWAY_PUBLIC_HOST=gateway.example.invalid

# ── Optional (defaults shown) ──────────────────────────────────────────────────

# WebSocket URL of the OpenClaw gateway (loopback only; 127.0.0.1 required)
# NOKIA_GATEWAY_URL=ws://127.0.0.1:18789

# Private state directory for registry.json and device-identity.json
# NOKIA_STATE_DIR=/home/nokia-bridge/.nokia-bridge

# Explicit path to provisioning JSON (deviceId + tokenHashes array)
# NOKIA_PROVISIONING_FILE=/home/nokia-bridge/.nokia-bridge/provisioning.json

# Explicit path to device identity JSON (ed25519 key pair — server-side only)
# NOKIA_IDENTITY_FILE=/home/nokia-bridge/.nokia-bridge/device-identity.json

# HTTP bind port (loopback only; 127.0.0.1 is hardcoded)
# NOKIA_BIND_PORT=18881

# ── Security notes ─────────────────────────────────────────────────────────────
# NOKIA_PROVISIONING_FILE and NOKIA_IDENTITY_FILE must be mode 0600 and owned
# by the bridge service user. The state directory must be mode 0700.
#
# The handset token is embedded in its private package using NOKIA_BRIDGE_URL
# and NOKIA_CONFIG_FILE (a mode-0600 JSON file containing token or bridgeToken).
# It is extractable from the zip. Use a per-device token; rotate on compromise.
#
# The gateway Funnel route is shared infrastructure. The bridge enforces the
# /nokia/v1 path boundary but the public URL itself is not zero-risk: keep the
# provisioning hash list tight and monitor for unexpected authenticated requests.
